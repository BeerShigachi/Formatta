# Exclude source maps and TypeScript sources
src/**
*.ts
*.map

node_modules/*
# Bundle node-fetch module to download Haskell CLI
!node_modules/node-fetch/**

# Exclude build output except .js files
out/**
!out/**/*.js

# Include the Haskell CLI binary
!bin/formatta

# Include the gif used in the README
!vscode-extension/media/demo.gif

# Exclude config and test files
.vscode/**
test/**
README.md
CHANGELOG.md